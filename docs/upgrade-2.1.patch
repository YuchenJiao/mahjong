+  const h: number[] = [];
+  for (const m of s.matchAll(/([1-9]+)([mps])|([ESWNCFP])/g)) {
+    if (m[1]) for (const n of m[1]) h.push("mps".indexOf(m[2])*9+Number(n)-1);
+    else h.push(27+"ESWNCFP".indexOf(m[3]));
+  }
