+.turn-status > span:not(.status-dot) { font-size: 13px; line-height: 1.6; }
+.status-dot { width: 9px; height: 9px; }
+.actions { gap: 9px; }
+.actions button { min-height: 48px; padding: 11px 20px; font-size: 17px; font-weight: 650; border-radius: 10px; touch-action: manipulation; }
+.aside-tabs button { font-size: 14px; }
+.advice-panel h3, .rules-panel h3 { font-size: 21px; }
+.advice-panel p, .rules-panel p, .log-panel li, .assistant-note { font-size: 14px; line-height: 1.7; }
+.recommend b { font-size: 24px; }
+.recommend span, .metrics span, .metrics label { font-size: 13px; }
+.metrics b, .metrics strong { font-size: 24px; }
+.useful, .alternatives, .storage-tools { font-size: 14px; }
+.room-panel-heading p, .room-entry label, .room-seats span, .room-actions > span { font-size: 13px; }
+.room-seats strong { font-size: 16px; }
+.room-entry input, .room-entry button, .room-actions button { min-height: 44px; }
+/* Animation changes presentation only; claim buttons retain stable DOM keys. */
+.tile.entering { animation: river-drop .35s cubic-bezier(.2,.8,.3,1) both; }
+.last-discard { animation: latest-card .32s ease-out; }
+.human-hand .tile.drawn:not(.selected) { animation: draw-card .35s ease-out; }
+.meld { animation: meld-reveal .32s ease-out; }
+.event-bubble { animation: announce .35s cubic-bezier(.2,.8,.3,1); }
+.action-flash { animation: action-glow .7s ease-out; }
+@keyframes river-drop { from { opacity: 0; transform: translateY(-16px) scale(1.15); } to { opacity: 1; transform: translateY(0) scale(1); } }
+@keyframes latest-card { from { opacity: .2; transform: scale(.82) rotate(-5deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
+@keyframes draw-card { from { opacity: .25; transform: translateX(18px); } to { opacity: 1; transform: translateX(0); } }
+@keyframes meld-reveal { from { opacity: .3; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes announce { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: scale(1); } }
+@keyframes action-glow { 30% { box-shadow: inset 0 0 0 2px #c89a45, 0 0 18px #c89a4533; } }
+@media (min-width: 1450px) { :root { --tile-w: 64px; --tile-h: 90px; } }
+@media (max-width: 1340px) {
+  .layout { grid-template-columns: 1fr; }
+  .layout aside { max-height: none; }
+  .advice-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 0 25px; }
+  .advice-panel > .eyebrow, .advice-panel > h3, .assistant-note, .storage-tools { grid-column: 1 / -1; }
+}
+@media (max-width: 950px) {
+  :root { --tile-w: 48px; --tile-h: 68px; }
+  .table { --rail-width: 128px; min-width: 780px; min-height: 670px; padding: 14px; gap: 14px 10px; grid-template-rows: auto auto minmax(300px, auto) auto; }
+  .opponent { --small-w: 26px; --small-h: 37px; padding: 10px 8px; }
+  .opponent.current { padding: 9px 7px; }
+  .river { --small-w: 28px; --small-h: 40px; }
+  .river-area { grid-template-columns: minmax(0, 1fr) 80px minmax(0, 1fr); gap: 14px 10px; grid-template-rows: minmax(150px, auto) minmax(150px, auto); }
+  .center-marker { width: 80px; }
+  .center-marker .tile { --face-w: 56px; --face-h: 78px; }
+  .action-bar { min-width: 780px; padding: 16px; }
+  .player-meta strong { font-size: 14px; }
+}
+@media (max-width: 700px) {
+  .app main { padding: 18px 12px; }
+  .game-heading h2 { font-size: 26px; }
+  .game-controls { max-width: none; gap: 10px; }
+  .game-controls button, .game-controls select { min-height: 44px; }
+  .topbar { height: auto; min-height: 82px; gap: 12px; flex-wrap: wrap; padding: 15px 12px; }
+  .header-tools { gap: 9px; flex-wrap: wrap; }
+  .header-tools button { min-height: 40px; }
+  .save-status { font-size: 12px; }
+  .advice-panel { display: block; }
+  .actions button { min-height: 48px; font-size: 16px; }
+}
+@media (orientation: landscape) and (max-height: 600px) {
+  :root { --tile-w: 46px; --tile-h: 66px; }
+  .app main { padding: 12px; }
+  .game-heading { margin-bottom: 16px; }
+  .game-controls { max-width: none; font-size: 13px; }
+  .game-controls select, .game-controls button { min-height: 40px; }
+  .table { --rail-width: 120px; min-width: 760px; min-height: 610px; padding: 12px; gap: 12px 10px; grid-template-rows: auto auto minmax(290px, auto) auto; }
+  .table-topline { font-size: 14px; }
+  .remaining-badge strong { font-size: 26px; }
+  .table-state { font-size: 13px; }
+  .river-area { grid-template-columns: minmax(0, 1fr) 76px minmax(0, 1fr); grid-template-rows: minmax(145px, auto) minmax(145px, auto); gap: 12px 10px; }
+  .opponent { --small-w: 25px; --small-h: 36px; }
+  .river { --small-w: 27px; --small-h: 38px; }
+  .river-label { font-size: 12px; }
+  .center-marker { width: 76px; }
+  .center-marker .tile { --face-w: 52px; --face-h: 74px; }
+  .human-zone { padding-top: 14px; }
+  .human-info strong { font-size: 17px; }
+  .human-info span { font-size: 13px; }
+  .human-info b { font-size: 24px; }
+  .human-hand { min-height: 78px; gap: 5px; }
+  .action-bar { min-width: 760px; min-height: 96px; margin-top: 12px; padding: 14px; }
+  .turn-status { font-size: 17px; }
+  .actions button { min-height: 46px; font-size: 16px; padding: 10px 16px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .tile, .meld, .last-discard, .event-bubble, .action-flash { animation: none !important; transition: none !important; }
+}
+.is-replay .tile, .is-replay .meld, .is-replay .last-discard { animation: none; }
