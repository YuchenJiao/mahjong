# For a separately deployed Vercel/Pages frontend, set this before npm run build:
VITE_ONLINE_API_URL=https://your-mahjong-server.onrender.com
# Set on the Node backend only when frontend is hosted at a different origin:
ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Optional persistent local database path (default .data/rooms.sqlite):
ONLINE_DB_PATH=.data/rooms.sqlite
